<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_marginTop="10dp"
        android:background="@drawable/edit_logn_bg"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:orientation="horizontal"
        android:layout_marginStart="0dp"
        android:gravity="center_vertical"> <!-- 垂直方向上对齐中心线 -->
        <TextView
            android:id="@+id/music_much_red"
            android:layout_marginStart="15dp"
            android:layout_width="30dp"
            android:layout_height="50dp"
            android:text="1"
            android:textStyle="bold"
            android:textSize="30sp"/>
        <!-- 1. 图片 -->
        <ImageView
            android:id="@+id/music_img_love"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:scaleType="centerCrop"
            android:layout_marginStart="15dp"
            android:src="@drawable/beizi" />

        <!-- 2. 歌名 -->
        <TextView
            android:id="@+id/music_love_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:text="歌名"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FAFAFA" />

        <!-- 3. 歌手 -->
        <TextView
            android:id="@+id/music_love_singer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="歌手"
            android:textSize="14sp"
            android:textColor="#FBFBFB" />

    </LinearLayout>


</LinearLayout>