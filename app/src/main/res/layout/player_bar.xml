<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_bar"
    android:visibility="gone"
    android:backgroundTint="#DB8AE0"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/white_round_bg"
    android:layout_marginLeft="5dp"
    android:layout_marginRight="5dp">

    <!-- 1. 上面的 SeekBar -->
    <SeekBar
        android:id="@+id/user_seekbar"
        android:padding="5dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:thumbTint="#E73E3E3E" />

    <LinearLayout
        android:id="@+id/user_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/user_home_photo"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_marginLeft="15dp"
            android:src="@drawable/namianlihuas"
            android:background="@drawable/edit_logn_bg" />

        <TextView
            android:id="@+id/user_home_name"
            android:layout_marginLeft="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="梨花瘦—七月"
            android:textSize="20sp"
            android:textColor="#6B6868" />

    </LinearLayout>

    <!-- 2. 下面的图标区域容器 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView
            android:id="@+id/bianhua"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="30dp"
            android:src="@drawable/sun_br" />
        <ImageView
            android:id="@+id/music_s"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="30dp"
            android:src="@drawable/music_s" />
        <ImageView
            android:id="@+id/play_qidong_run"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="0dp"
            android:layout_marginEnd="20dp"
            android:src="@drawable/br" />
        <ImageView
            android:id="@+id/music_x"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginRight="10dp"
            android:src="@drawable/music_x" />
        <ImageView
            android:id="@+id/music_star"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="10dp"
            android:layout_marginRight="20dp"
            android:src="@drawable/music_star" />

    </LinearLayout>
</LinearLayout>
